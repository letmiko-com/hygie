# next-auth 5 (and its @auth/core) declares an OPTIONAL peer dependency on nodemailer
# ^7 || ^8, for the default transport of its email provider. Hygie never uses that
# transport (src/auth.ts owns the send) and runs nodemailer 10 to be clear of the
# advisories on 8 and 9. npm 10 (the Docker image) refuses that optional conflict
# under `npm ci` while npm 12 tolerates it; this makes both behave alike.
legacy-peer-deps=true
