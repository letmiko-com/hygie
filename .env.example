# Hygie configuration contract. Copy to .env and fill in. Never commit .env.

# Postgres (Railway: use the private-network URL of the postgres service)
DATABASE_URL=postgres://user:password@host:5432/hygie

# Base URL of this instance (magic links point here)
HYGIE_BASE_URL=http://localhost:3000

# SMTP relay for magic links (any provider; port 2587 works from Railway Hobby)
SMTP_HOST=
SMTP_PORT=2587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Hygie <hygie@example.com>"
# Dev/test only: capture magic link emails as JSON files in this directory
# instead of sending them (nodemailer jsonTransport). Never set in production.
# HYGIE_MAIL_CAPTURE_DIR=

# Silence alert: hours without any batch from a paired device before the members
# of its subject and every admin get one email (the next batch re-arms it). The
# same value flags the device as behind on the Devices and Sync screens and on
# the dashboard. Default 24; 0 turns the email off.
# HYGIE_SILENCE_ALERT_HOURS=24

# One-time bootstrap: creates the first admin account at startup if no user exists.
# Remove after first login.
HYGIE_BOOTSTRAP_ADMIN_EMAIL=

# Auth.js secret (openssl rand -hex 32)
AUTH_SECRET=

# Directory where raw ingest bodies are stored (a persistent volume in production)
HYGIE_DATA_DIR=/data

# Map tiles under the GPS trace of a session, fetched by THIS server (proxy with a
# disk cache under HYGIE_DATA_DIR/tiles) so the browser never contacts the provider.
# Default: OpenStreetMap standard tiles (their usage policy: light use, attribution).
# Any {z}/{x}/{y} template works; "off" disables the map (plain trace).
# HYGIE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# HYGIE_TILE_ATTRIBUTION=© OpenStreetMap contributors

